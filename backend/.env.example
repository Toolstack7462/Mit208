# PhishGuard backend configuration
# ---------------------------------
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is listed in .gitignore.

# --- Database ---------------------------------------------------------------
# PostgreSQL is the official target. Create the database first:
#   createdb phishguard_db     (or use database/schema.sql)
# Replace USER and PASSWORD with your own local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/phishguard_db

# Zero-install fallback (no PostgreSQL required):
# DATABASE_URL=sqlite:///./phishguard.db

# --- Environment ------------------------------------------------------------
# development | production
# "production" refuses to start with a weak SECRET_KEY and hides internal
# error detail from API responses.
ENVIRONMENT=development

# --- JWT signing secret -----------------------------------------------------
# REQUIRED. Must be at least 32 characters and must NOT be left as the
# placeholder below. Generate your own value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# If this is left unchanged, the app still starts in development but signs
# tokens with a random per-process key (sessions reset on restart). With
# ENVIRONMENT=production it refuses to start at all.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS -------------------------------------------------------------------
# Origin of the Vite dev server / deployed frontend.
FRONTEND_ORIGIN=http://localhost:5173

# --- Login brute-force protection ------------------------------------------
# Max failed login attempts per client IP within the rolling window.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
